DEBUG_ENDPOINTS=false

REDIS_URL=redis://localhost:6379/0

POSTGRES_USER=nomanual
POSTGRES_PASSWORD=nomanual
POSTGRES_DB=nomanual
POSTGRES_PORT=5433
DATABASE_URL=postgresql+asyncpg://nomanual:nomanual@localhost:5433/nomanual

EMBEDDING_MODEL=text-embedding-3-small

OPENAI_API_KEY=
KIMI_API_KEY=
