LANGSMITH_PROJECT=nomanual
# The region the key belongs to. A key from an EU workspace sent to the US
# endpoint is rejected with a 403 that says only "Forbidden".
# EU: https://eu.api.smith.langchain.com
LANGSMITH_ENDPOINT=https://api.smith.langchain.com

