# Everything here would either bloat the image or leak something.
#
# .env first: it holds the OpenAI key, and a file copied into a layer stays in
# that layer forever, even if a later instruction deletes it.
.env
.env.*
!.env.example

.venv
**/__pycache__
**/*.pyc
.pytest_cache
.ruff_cache
.mypy_cache

node_modules
frontend/dist
frontend/node_modules

# Local data, not part of the application.
uploads
test_manuals
evals/results

.git
.github
*.md
!README.md
